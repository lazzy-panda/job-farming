// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Source {
  id          String        @id @default(cuid())
  name        String
  sourceType  String
  url         String?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  jobPostings JobPosting[]
}

model JobPosting {
  id           String        @id @default(cuid())
  title        String
  description  String?
  rawContent   String?
  company      String?
  location     String?
  link         String?
  status       String        @default("new")
  tags         String?
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sourceId     String?
  source       Source?       @relation(fields: [sourceId], references: [id])
  applications Application[]
}

model Application {
  id            String       @id @default(cuid())
  jobPostingId  String
  jobPosting    JobPosting   @relation(fields: [jobPostingId], references: [id])
  channel       String
  status        String       @default("pending")
  kind          String       @default("template")
  resumeVersion String?
  sentAt        DateTime     @default(now())
  repliedAt     DateTime?
  interviewAt   DateTime?
  notes         String?
  createdAt     DateTime     @default(now())
  scoreEvents   ScoreEvent[]
}

model ScoreEvent {
  id            String       @id @default(cuid())
  date          DateTime     @default(now())
  type          String
  points        Int
  note          String?
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
}

model DeletedJob {
  id        String   @id @default(cuid())
  link      String?  @unique
  createdAt DateTime @default(now())
}

model Template {
  id        String   @id @default(cuid())
  name      String
  content   String
  channel   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Resume {
  id        String   @id @default(cuid())
  name      String   @unique
  title     String
  content   String
  notes     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id        Int     @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

model Proxy {
  id            String   @id @default(cuid())
  host          String
  port          Int
  protocol      ProxyProtocol @default(http)
  username      String?
  password      String?
  userAgent     String?
  userAgentSource String?
  userAgentUpdatedAt DateTime?
  cookieHeader  String?
  cookieSource  String?
  cookieUpdatedAt DateTime?
  active        Boolean  @default(true)
  lastCheckedAt DateTime?
  lastStatus    String?
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum ProxyProtocol {
  http
  https
  socks5
}
