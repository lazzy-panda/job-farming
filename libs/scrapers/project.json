{
  "name": "scrapers",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/scrapers/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/scrapers",
        "main": "libs/scrapers/src/index.ts",
        "tsConfig": "libs/scrapers/tsconfig.lib.json",
        "assets": ["libs/scrapers/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/scrapers/jest.config.ts"
      }
    }
  }
}
